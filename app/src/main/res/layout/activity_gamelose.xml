<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_margin="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="130dp"
        android:id="@+id/ueberschrift"
        android:gravity="center_horizontal"
        android:textSize="28dp"
        android:textColor="@color/black"
        android:layout_marginBottom="40dp"
        android:text="Versuche es nochmal!"
        >
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:id="@+id/schwierigkeit"
        android:gravity="center_horizontal"
        android:textSize="20dp"
        android:text="Die maximale Fehleranzahl wurde erreicht">

    android:textColor="@color/black"
        android:gravity="center"
        android:layout_margin="20dp">
    </TextView>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Startseite"
        android:backgroundTint="#33379e"
        android:layout_marginTop="100dp"
        android:id="@+id/startseite"
        android:layout_gravity="center_horizontal">
    </Button>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Neues Spiel"
        android:backgroundTint="#33379e"
        android:layout_gravity="center_horizontal"
        android:id="@+id/neuesSpiel">
    </Button>

</LinearLayout>